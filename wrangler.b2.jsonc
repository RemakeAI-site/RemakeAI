{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remake-ai-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_zlib"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remake-ai-studio",
      "database_id": "14bf1056-32f5-4533-b45e-4c7e99914ee8",
      "migrations_dir": "database/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    },
    {
      "name": "READ_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 500,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "31 2 * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "MAX_STORAGE_BYTES": "9000000000",
    "BACKUP_IMPORT_ENABLED": "0",
    "B2_ENDPOINT": "s3.us-east-005.backblazeb2.com",
    "B2_BUCKET": "remake-ai-studio-media"
  }
}
