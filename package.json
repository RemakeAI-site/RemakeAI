{
  "name": "remake-ai-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/local.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "wrangler d1 migrations apply remake-ai-studio --local",
    "db:seed": "wrangler d1 execute remake-ai-studio --local --file database/seeds/initial.sql",
    "test": "node --test tests/unit.test.mjs",
    "test:integration": "node scripts/test-local.mjs",
    "test:e2e": "node scripts/test-local.mjs --e2e",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0",
    "@tanstack/react-query": "^5.90.0",
    "aws4fetch": "^1.0.20",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261114.1",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.39.0",
    "vite": "^6.3.0",
    "wrangler": "4.162.0"
  }
}
